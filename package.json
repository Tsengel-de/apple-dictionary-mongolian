{
  "name": "apple-dictionary-mongolian",
  "version": "1.0.0",
  "description": "Dual-Script Apple Dictionaries for macOS (Altangerel & Tsevel) with Traditional Mongolian Script and Classical Latin Galig",
  "scripts": {
    "build:bichig": "node scripts/generate_bichig_mapping.mjs",
    "build:dict": "python3 src/build_dictionary.py --dict all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tsengel-de/apple-dictionary-mongolian.git"
  },
  "keywords": [
    "mongolian",
    "apple-dictionary",
    "macos",
    "hudum-bichig",
    "traditional-mongolian",
    "altangerel",
    "tsevel"
  ],
  "author": "Tsengel <tsengel@tsengel.de> (https://tsengel.de)",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Tsengel-de/apple-dictionary-mongolian/issues"
  },
  "homepage": "https://github.com/Tsengel-de/apple-dictionary-mongolian#readme",
  "dependencies": {
    "@gege-mn/gege-converter": "^0.8.1"
  }
}
